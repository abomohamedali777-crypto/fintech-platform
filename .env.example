# Copy to .env.local and fill in. NEVER commit .env.local.
DATABASE_URL=postgresql://...your supabase connection string...?sslmode=require
RESEND_API_KEY=re_...
NOTIFY_TO=you@yourcompany.com
NOTIFY_FROM=Mizan Access <access@yourdomain.com>

# Rate limiting (optional overrides)
RATE_LIMIT_IP_LIMIT=5
RATE_LIMIT_IP_WINDOW_MS=600000
RATE_LIMIT_EMAIL_LIMIT=2
RATE_LIMIT_EMAIL_WINDOW_MS=3600000

# Salt used to hash client IPs before they touch the database (optional)
ACCESS_IP_SALT=change-me