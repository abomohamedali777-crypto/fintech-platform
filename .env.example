# Copy to .env.local and fill in. NEVER commit .env.local.

# --- Site ---
# Canonical production URL used for sitemap, robots.txt, security.txt,
# metadataBase/open-graph, and the default API allowed-origin.
# On Vercel free tier this is usually https://<project>.vercel.app.
SITE_URL=https://mizan.vercel.app

# Public support / contact address shown in the footer and legal pages.
NEXT_PUBLIC_SUPPORT_EMAIL=hello@mizan.pay

# Security contact shown in /.well-known/security.txt.
SECURITY_CONTACT=security@mizan.pay

# --- Request-access pipeline ---
# Postgres (Supabase free tier works) connection string. Required for the API
# to persist requests and for distributed rate limiting. When unset, the API
# responds 503 with an honest message.
DATABASE_URL=postgresql://postgres:...@db.<project>.supabase.co:5432/postgres?sslmode=require
# Self-signed/local databases only:
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Resend free-tier API key (emails the recorded request to you, best-effort).
RESEND_API_KEY=re_...
NOTIFY_TO=you@yourcompany.com
NOTIFY_FROM=Mizan Access <access@mizan.pay>

# Salt used to hash client IPs before they reach the database.
# REQUIRED in production: generate a random secret of >= 32 chars with
# `openssl rand -hex 32` or similar. Well-known values — the old "mizan"
# default or the placeholder below — are treated as weak and REJECTED in
# production: the API fail-closes to an empty salt, warns loudly, and refuses
# to boot when STRICT_PROD_GUARD=1. You can leave this unset for local
# dev/testing.
ACCESS_IP_SALT=change-me-to-a-32+char-random-value

# Comma-separated list of origins allowed to POST to /api/access.
# Must match the origin the browser is served from. Defaults to SITE_URL.
# In production, warn loudly if localhost or non-HTTPS origins remain.
ALLOWED_ORIGINS=https://mizan.vercel.app

# --- Rate limiting (optional overrides) ---
RATE_LIMIT_IP_LIMIT=5
RATE_LIMIT_IP_WINDOW_MS=600000
RATE_LIMIT_EMAIL_LIMIT=2
RATE_LIMIT_EMAIL_WINDOW_MS=3600000

# --- Guardrails ---
# Set to 1 in production: any config warning (weak ACCESS_IP_SALT, insecure
# ALLOWED_ORIGINS, ...) becomes a fatal error at build/import time instead of
# a log line, so misconfigured deploys fail fast.
STRICT_PROD_GUARD=0

# --- Intelligence Engine (Legal & Regulatory RAG) ---
# POST /api/intelligence. Works fully in local-synthesis mode with zero config;
# the AI provider is optional and only used when explicitly enabled below.
# See INTELLIGENCE.md for the manual ingestion and deployment walkthrough.

# Question / body limits.
INTEL_MAX_QUERY_CHARS=500
INTEL_MAX_BODY_BYTES=8192

# IP rate limiting for the intelligence endpoint (independent bucket, shares
# ACCESS_IP_SALT above).
INTEL_RATE_LIMIT_IP_LIMIT=12
INTEL_RATE_LIMIT_IP_WINDOW_MS=600000

# Sources that may POST to /api/intelligence. Defaults to SITE_URL (+ localhost
# in non-production). Same production-HTTP(S)-only rules as ALLOWED_ORIGINS.
INTEL_ALLOWED_ORIGINS=https://mizan.vercel.app

# Optional bearer token for the endpoint. Leave unset to allow anonymous,
# rate-limited research (recommended for a public console). When set, every
# request must send `Authorization: Bearer <value>`.
INTEL_TOKEN=

# --- Retrieval tuning ---
INTEL_RETRIEVE_TOP_K=4
INTEL_CONTEXT_MAX_CHARS=6000

# --- AI provider (OPTIONAL) ---
# Leave INTEL_AI_PROVIDER empty to always use deterministic local synthesis.
# Set to `openai-compatible` and add a key to enable the LLM path. The engine
# falls back to local synthesis automatically on any provider error and never
# exposes the key to the browser.
INTEL_AI_PROVIDER=
INTEL_AI_BASE_URL=https://api.openai.com/v1
INTEL_AI_API_KEY=
INTEL_AI_MODEL=gpt-4o-mini
INTEL_AI_MAX_TOKENS=700
INTEL_AI_TIMEOUT_MS=15000

# --- Query cache (bounded, in-memory) ---
INTEL_CACHE_TTL_MS=300000
INTEL_CACHE_MAX=64

# --- Durable corpus mirror (OPTIONAL) ---
# Set to 1 to mirror the corpus into Postgres (intel_documents/intel_chunks,
# see intel-schema.sql) when DATABASE_URL is configured. In-memory retrieval
# always works regardless.
INTEL_PERSIST_DB=0