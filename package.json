{
  "name": "fintech-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Automated Liquidity & Settlement Infrastructure",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "ingest": "tsx scripts/ingest.ts",
    "serve": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/serve.ps1 start",
    "serve:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/serve.ps1 start",
    "serve:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/serve.ps1 stop",
    "serve:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/serve.ps1 status",
    "serve:logs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/serve.ps1 logs",
    "serve:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/serve.ps1 restart",
    "serve:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/serve.ps1 install",
    "serve:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/serve.ps1 uninstall"
  },
  "dependencies": {
    "framer-motion": "^13.2.0",
    "lucide-react": "^0.454.0",
    "next": "^16.3.4",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.27.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.20.0",
    "typescript": "^5.6.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}

